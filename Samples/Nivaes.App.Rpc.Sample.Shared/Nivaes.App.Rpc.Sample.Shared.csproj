<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>

		<AssemblyName>Nivaes.App.Rpc.Sample</AssemblyName>
		<RootNamespace>Nivaes.App.Rpc.Sample</RootNamespace>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Sources\Nivaes.App.Rpc.Shared\Nivaes.App.Rpc.Shared.csproj" />
		<ProjectReference Include="..\..\Sources\Nivaes.App.Rpc.SourceGenerator\Nivaes.App.Rpc.SourceGenerator.csproj"   
						  OutputItemType="Analyzer"
						  ReferenceOutputAssembly="false"
						  IncludeAssets="analyzers;"
						  PrivateAssets="contentfiles; buildtransitive"
					      ExcludeAssets="runtime; build; native; contentfiles; buildtransitive"
						  />
	</ItemGroup>

</Project>
