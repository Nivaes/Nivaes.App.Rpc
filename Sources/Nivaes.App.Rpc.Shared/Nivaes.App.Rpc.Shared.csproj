<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(_CommonTargets)</TargetFrameworks>
		<AssemblyName>Nivaes.App.Rpc</AssemblyName>
		<RootNamespace>Nivaes.App.Rpc</RootNamespace>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<IsAotCompatible>true</IsAotCompatible>
		<!--<RunAOTAnalysis>true</RunAOTAnalysis>-->
		<!--<WarningsAsErrors>IL2CPP;IL3xxx</WarningsAsErrors>-->
		<OptimizationPreference>Speed</OptimizationPreference>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Nivaes.App.Rpc</PackageId>
		<Title>Nivaes.App.Rpc</Title>

		<Product>Nivaes.App.Rpc</Product>
		<Description>Nivaes.App.Rpc.</Description>
		<PackageTags>Nivaes.App.Rpc</PackageTags>
		<PackageReadmeFile>Readme.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MemoryPack" />
		<PackageReference Include="Nivaes.Extensions" />
		<PackageReference Include="protobuf-net.Grpc" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Nivaes.App.Rpc.Client" />
		<InternalsVisibleTo Include="Nivaes.App.Rpc.AspNetCore.Server" />
		<InternalsVisibleTo Include="Nivaes.App.Rpc.Sample.Tests"/>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Nivaes.App.Rpc.SourceGenerator\Nivaes.App.Rpc.SourceGenerator.csproj" 
						  OutputItemType="Analyzer"
						  ReferenceOutputAssembly="false"
						  PrivateAssets="none"
						  IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="icon.png" />
		<None Include="Docs\Readme.md" Pack="true" PackagePath="Readme.md" />
	</ItemGroup>

</Project>
